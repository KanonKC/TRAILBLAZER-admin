{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trailblazer-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  // NEXT_PUBLIC_* vars are inlined into the client bundle by `next build`, which
  // `npm run deploy` runs first — these `vars` only affect the server-side worker
  // (e.g. next.config.ts's rewrites()), not already-built client JS. Make sure the
  // same values are present in the shell/CI env (or a .env.production file) before
  // deploying, so both the client bundle and this config agree.
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api.trailblazer.bz",
    "NEXT_PUBLIC_CDN_ORIGIN": "https://cdn.trailblazer.bz"
  }
}
